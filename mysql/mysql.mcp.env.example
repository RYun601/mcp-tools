# MySQL MCP connection settings (copy to .vscode/mysql.mcp.env)
# Data source: local or remote MySQL instance
# Security: use least-privilege credentials for AI access
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=replace_me
# designcomputer/mysql_mcp_server key names
MYSQL_PASSWORD=replace_me
MYSQL_DATABASE=replace_me
# benborla/mcp-server-mysql key names
MYSQL_PASS=replace_me
MYSQL_DB=replace_me
